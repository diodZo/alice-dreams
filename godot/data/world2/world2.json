 "signs": [
  {
   "x": 5,
   "y": 20,
   "text": "Mundo 2: el Reino de los Crayones Encantados. ¡Tus tres armas te acompañan!"
  },
  {
   "x": 36,
   "y": 20,
   "text": "Las reglas sirven de puente: ¡crúzalas!"
  },
  {
   "x": 58,
   "y": 20,
   "text": "Algunas reglas están inclinadas: sube con cuidado"
  },
  {
   "x": 97,
   "y": 20,
   "text": "La pintura AZUL resbala: frena con tiempo"
  },
  {
   "x": 129,
   "y": 19,
   "text": "Los puentes dibujados aparecen y desaparecen. ¡Atento al parpadeo!"
  },
  {
   "x": 158,
   "y": 19,
   "text": "Toca el molinillo para dibujar el puente"
  },
  {
   "x": 233,
   "y": 19,
   "text": "Cruza el río de pintura sobre los cuadernos"
  },
  {
   "x": 238,
   "y": 19,
   "text": "La pintura AMARILLA rebota. Mantén SALTAR para subir más"
  },
  {
   "x": 327,
   "y": 19,
   "text": "La pintura ROSA es pegajosa: te frena"
  },
  {
   "x": 348,
   "y": 19,
   "text": "¡Los borradores pueden borrar los puentes dibujados!"
  },
  {
   "x": 460,
   "y": 19,
   "text": "El Gran Lienzo. ¡Garabato te espera!"
  }
 ],
