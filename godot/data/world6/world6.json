 "signs": [
  {
   "x": 3,
   "y": 20,
   "text": "Mundo 5: ¡El Reino del Tren de Juguete! Viaja en los trenes mágicos entre las nubes"
  },
  {
   "x": 9,
   "y": 20,
   "text": "Toca la campana de la estación: ¡Din don!"
  },
  {
   "x": 21,
   "y": 20,
   "text": "Sube al vagón cuando el tren pare en la estación. Puedes andar y saltar encima"
  },
  {
   "x": 46,
   "y": 20,
   "text": "Golpea los bloques de estrella desde abajo: ¡sueltan estrellas!"
  },
  {
   "x": 66,
   "y": 20,
   "text": "Las plataformas con hélice flotan. Sus hélices no hacen daño"
  },
  {
   "x": 120,
   "y": 19,
   "text": "El puente arcoíris une las islas: ¡crúzalo!"
  },
  {
   "x": 141,
   "y": 19,
   "text": "Toca la palanca para cambiar el desvío. El tren lo toma al volver a la estación"
  },
  {
   "x": 189,
   "y": 15,
   "text": "El Payasito Resorte salta de su caja y lanza estrellas: ¡apártate!"
  },
  {
   "x": 238,
   "y": 18,
   "text": "Hay tres billetes dorados escondidos en el reino"
  },
  {
   "x": 279,
   "y": 18,
   "text": "Este tren rápido espera en la estación: toca la campana para llamarlo"
  },
  {
   "x": 302,
   "y": 18,
   "text": "El Vagoncito Chispa lanza chispas y suelta humo. El humo no hace daño"
  },
  {
   "x": 329,
   "y": 19,
   "text": "La hélice que sube lleva a la ruta del cielo"
  },
  {
   "x": 342,
   "y": 19,
   "text": "Este tren para a mitad de camino: ¡hay estrellas en la pasarela!"
  },
  {
   "x": 392,
   "y": 19,
   "text": "La Fábrica de Juguetes: los bloques tiemblan antes de caer"
  },
  {
   "x": 419,
   "y": 21,
   "text": "Las ruedas ruedan siempre igual: ¡sáltalas! El resorte te sube a la meseta"
  },
  {
   "x": 472,
   "y": 17,
   "text": "Las barreras de estrella te empujan sin hacer daño"
  },
  {
   "x": 586,
   "y": 19,
   "text": "¡Cuidado! Cuando la señal se pone roja y suena el silbato, sale un tren del túnel"
  },
  {
   "x": 620,
   "y": 19,
   "text": "La Gran Estación Real: Locomostro te espera"
  }
 ],
