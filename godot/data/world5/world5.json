 "signs": [
  {
   "x": 3,
   "y": 20,
   "text": "Mundo 6: ¡Sueños Cósmicos! Explora las islas del cielo con tus tres armas"
  },
  {
   "x": 28,
   "y": 20,
   "text": "La estrella sólida se pisa. La estrella con muelle es un trampolín"
  },
  {
   "x": 59,
   "y": 19,
   "text": "La Estrellita Fugaz vuela rápido y lanza miniestrellas"
  },
  {
   "x": 128,
   "y": 19,
   "text": "Las lunas crecientes forman un camino: ¡salta de una a otra!"
  },
  {
   "x": 161,
   "y": 19,
   "text": "El Cohetito Centinela enciende el motor antes de disparar"
  },
  {
   "x": 173,
   "y": 19,
   "text": "Métete en la cascada de luz dorada: te subirá hasta arriba"
  },
  {
   "x": 248,
   "y": 19,
   "text": "Sube al cohete: te lleva sobre el vacío"
  },
  {
   "x": 268,
   "y": 16,
   "text": "El tobogán arcoíris desliza rápido: las flechas frenan o aceleran un poco"
  },
  {
   "x": 297,
   "y": 20,
   "text": "La plataforma de lanzamiento te lanza muy alto: arriba hay un tesoro"
  },
  {
   "x": 369,
   "y": 21,
   "text": "El cohete ascensor sube y baja: espera a que llegue"
  },
  {
   "x": 389,
   "y": 17,
   "text": "¡Lluvia de meteoros! Las estrellas que caen avisan con un destello"
  },
  {
   "x": 408,
   "y": 17,
   "text": "Las nubes explosivas estallan si las tocas: ¡dispárales desde lejos!"
  },
  {
   "x": 533,
   "y": 19,
   "text": "El Trono de la Luna: Luna Estelar te espera"
  }
 ],
