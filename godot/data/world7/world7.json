   "x": 302,
   "y": 21,
   "text": "La Piruleta Voladora lanza caramelitos en abanico: busca el hueco"
  },
  {
   "x": 320,
   "y": 21,
   "text": "La goma te sube a los malvaviscos: ¡ruta de estrellas!"
  },
  {
   "x": 408,
   "y": 19,
   "text": "La Fábrica de Caramelos: las correas de chocolate te llevan"
  },
  {
   "x": 438,
   "y": 19,
   "text": "El lanzador brilla antes de disparar. Las piruletas giran siempre igual"
  },
  {
   "x": 452,
   "y": 19,
   "text": "Estas gelatinas tiemblan y desaparecen: ¡no te pares!"
  },
  {
   "x": 479,
   "y": 17,
   "text": "Esta correa va hacia atrás: ¡corre!"
  },
  {
   "x": 510,
   "y": 17,
   "text": "¡El tobogán de caramelo dorado!"
  },
  {
   "x": 564,
   "y": 19,
   "text": "El Castillo del Gran Pastel"
  },
  {
   "x": 645,
   "y": 19,
   "text": "Don Chupetón te espera dentro del castillo"
  }
 ],
