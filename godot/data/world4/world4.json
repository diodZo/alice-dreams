 "signs": [
  {
   "x": 7,
   "y": 20,
   "text": "Mundo 4: ¡El Reino de las Burbujas! Tus tres armas te acompañan"
  },
  {
   "x": 44,
   "y": 20,
   "text": "Las plataformas de burbujas flotan: ¡súbete a ellas!"
  },
  {
   "x": 82,
   "y": 20,
   "text": "En el agua pulsa salto para nadar. Cerca de la superficie, ¡salta fuera!"
  },
  {
   "x": 113,
   "y": 20,
   "text": "La espuma resbala: frena con tiempo"
  },
  {
   "x": 132,
   "y": 20,
   "text": "El géiser de burbujas te lanza muy alto: espera a que estalle"
  },
  {
   "x": 226,
   "y": 20,
   "text": "El Canal de los Patitos: sube a los barquitos"
  },
  {
   "x": 254,
   "y": 19,
   "text": "Las columnas de burbujas te elevan"
  },
  {
   "x": 317,
   "y": 17,
   "text": "Las burbujas frágiles revientan: ¡no te pares!"
  },
  {
   "x": 364,
   "y": 20,
   "text": "Salta a la cascada de burbujas: te subirá hasta arriba"
  },
  {
   "x": 388,
   "y": 14,
   "text": "Los rodillos de esponja empujan: pasa cuando se alejen"
  },
  {
   "x": 405,
   "y": 14,
   "text": "Bajo el agua flotas: pulsa salto para nadar hacia arriba"
  },
  {
   "x": 550,
   "y": 19,
   "text": "El Trono de Patoburbuja: ¡el Rey te espera!"
  }
 ],
